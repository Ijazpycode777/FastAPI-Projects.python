# =============================================================
# Smart Campus — environment variable template
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================

# ---- Application ----
APP_NAME=Smart Campus
APP_ENV=development            # development | production
APP_LOG_LEVEL=INFO             # DEBUG | INFO | WARNING | ERROR

# ---- Database (PostgreSQL) ----
# Use a full async SQLAlchemy URL. Example uses asyncpg driver.
DATABASE_URL=postgresql+asyncpg://smartcampus:smartcampus@localhost:5432/smartcampus
# Sync URL is used by Alembic migrations.
DATABASE_URL_SYNC=postgresql+psycopg2://smartcampus:smartcampus@localhost:5432/smartcampus
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ---- Sessions / cookies ----
# Session cookie name and signing key. Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SESSION_COOKIE_NAME=smartcampus_session
SESSION_SECRET_KEY=change-me-to-a-long-random-string
SESSION_MAX_AGE_SECONDS=28800    # 8 hours
SESSION_COOKIE_SECURE=false      # true in production (HTTPS)
SESSION_COOKIE_SAMESITE=lax

# ---- CSRF ----
CSRF_COOKIE_NAME=smartcampus_csrf
CSRF_SECURE=false

# ---- CORS ----
# Comma-separated list of allowed origins. In production set to the public URL.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Security ----
PASSWORD_MIN_LENGTH=10
PASSWORD_MAX_LENGTH=128
LOGIN_RATE_LIMIT=5/minute        # slowapi notation
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2

# ---- Teacher self-attendance ----
TEACHER_LATE_THRESHOLD_MINUTES=15
TEACHER_WORK_START=08:30         # HH:MM (24h)

# ---- File storage (study materials) ----
# local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage/materials
# For S3-compatible object storage (Render Disk for local in dev)
# STORAGE_S3_ENDPOINT=
# STORAGE_S3_BUCKET=
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_REGION=
MAX_UPLOAD_MB=25
ALLOWED_UPLOAD_EXTENSIONS=pdf,docx,pptx,png,jpg,jpeg,webp

# ---- Demo / seeding ----
SEED_ADMIN_EMAIL=admin@smartcampus.edu
SEED_ADMIN_PASSWORD=ChangeMe!2025
SEED_RESET_ON_START=false
